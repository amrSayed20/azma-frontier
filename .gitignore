# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Qiyamah First Generation Path — runtime-generated assets, never committed
/public/generated-assets/
# Creator uploads and rendered films — runtime data, never committed
/public/uploads/
/public/renders/

# Persistent Storage Foundation — the local SQLite database file
/data/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Claude Code project-local tooling config — permissions/settings, not application code
/.claude/

# Visual acceptance gate screenshots — proof artifacts, not source
/screenshots_pkg30/

# typescript
*.tsbuildinfo
next-env.d.ts

# transient release artifact produced by scripts/deploy.sh
.deploy-artifact.tar.gz
.reference-pack/

# Proof-harness CAPTURES — screenshots, recordings and wire dumps a run
# produced. The harness SCRIPTS beside them are source and are committed;
# their output is evidence from one run and belongs in the report, not here.
/scripts/proof-harness/*.png
/scripts/proof-harness/*.json
/scripts/proof-harness/tiktok-demo/
/scripts/proof-harness/tiktok-recording/

# BLOCKER C — the local protected storage root. `UPLOADS_DIR` points here for
# local work so that finished films are NEVER written under public/, where
# Next.js's static handler serves them before the authorisation gate. Creators'
# bytes, never committed.
/.local-uploads/
