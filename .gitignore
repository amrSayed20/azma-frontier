# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Qiyamah First Generation Path — runtime-generated assets, never committed
/public/generated-assets/

# Persistent Storage Foundation — the local SQLite database file
/data/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Claude Code project-local tooling config — permissions/settings, not application code
/.claude/

# Visual acceptance gate screenshots — proof artifacts, not source
/screenshots_pkg30/

# typescript
*.tsbuildinfo
next-env.d.ts
